# Copy this file to .env and fill in your key.
# A native Anthropic key (sk-ant-...) or a FastRouter gateway key (sk-v1-...).
ANTHROPIC_API_KEY=
# Optional gateway base URL. Set this for a FastRouter key; leave blank for a
# native Anthropic key (the SDK then talks to api.anthropic.com directly).
ANTHROPIC_BASE_URL=https://api.fastrouter.ai
# Model id. Via FastRouter use the catalog id "anthropic/claude-sonnet-5.5".
# Against Anthropic directly it would be "claude-sonnet-5-5".
AGENT_MODEL=anthropic/claude-sonnet-5.5
# Dataset bundle to use: datasets/<name>/ (semantic layer, examples, golden set)
# plus data/<name>.duckdb. Switch datasets with this one var; no code changes.
DATASET=olist
